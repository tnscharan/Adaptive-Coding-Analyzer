				"group": "servers",
				"panel": "dedicated"
			}
		},
		{
			"label": "backend ",
			"type": "shell",
			"windows": {
				"command": "python scripts\\run_backend.py --install"
			},
			"osx": {
				"command": "python3 scripts/run_backend.py --install"
			},
			"linux": {
				"command": "python3 scripts/run_backend.py --install"
			},
			"command": "python scripts/run_backend.py --install",
